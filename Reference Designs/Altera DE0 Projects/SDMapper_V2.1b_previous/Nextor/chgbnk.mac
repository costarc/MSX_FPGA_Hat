	.z80
	title	CHGBNK - Bank Switching Module for SDMapper_V2.1b (ASCII16 mapper)
;
;-----------------------------------------------------------------------
;
;   Manufacturer-supplied bank switching module, placed at the tail of
; every local bank of DOS2-ROM (see mknexrom's <mapperfile> contract).
;
;   SDMapper_V2.1b's ROM sub-slot uses a standard ASCII16-style bank
; register (rom_bank1_q in SDMapper_Top.vhd, written via address 6000h) -
; same mechanism Nextor's own StandaloneASCII16 driver targets, so this
; module is functionally identical to that one.
;
; Entry:  Acc = 0 --- switch to bank #0
;               1 --- switch to bank #1
;               ... up to bank #7 (3-bit register)
; Exit:   None
;
; Only AF can be modified
;
; *** CODE STARTS HERE ***	CAUTION!! This must be the first module.
;
BNKREG	equ	6000h

	org 7FD0h

CHGBNK:

	ld	(BNKREG),a
	ret
;
	defs	(8000h-7FD0h)-($-CHGBNK),0FFh
;
	end
