set_instance_assignment -name IO_STANDARD LVTTL -to SD1_MOSI
set_instance_assignment -name IO_STANDARD LVTTL -to SD1_MISO
# BUG FIX (2026-08-11, real hardware: SD card never responds - consistent
# 0xFF/0xFF SPI exchange). OneChipMSX_DE0 (C:\Users\roniv\Dev\FPGA\OneChipMSX_DE0,
# proven working on this same DE0 board/socket, same PIN_Y21/Y22/AA22/W21
# pins under different signal names pSd_Ck/Cm/Dt0/Dt3) explicitly enables the
# Cyclone III's internal weak pull-up resistor and a conservative 4mA drive
# strength on all four SD pins - our design had neither. The DE0's own
# schematic only shows board-level pull-ups on CMD/DAT3(CS), not DAT0(MISO),
# so an unselected/idle MISO line could float without this.
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SD1_CS
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to SD1_CS
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SD1_SCK
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to SD1_SCK
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SD1_MOSI
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to SD1_MOSI
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SD1_MISO
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to SD1_MISO
set_instance_assignment -name GLOBAL_SIGNAL OFF -to RD_n
set_instance_assignment -name GLOBAL_SIGNAL OFF -to WR_n
set_instance_assignment -name GLOBAL_SIGNAL OFF -to MREQ_n
set_instance_assignment -name GLOBAL_SIGNAL OFF -to IORQ_n
set_instance_assignment -name GLOBAL_SIGNAL OFF -to SLTSL_n
set_instance_assignment -name GLOBAL_SIGNAL OFF -to M1_n

