set_location_assignment PIN_C2 -to LEDG[7]
set_location_assignment PIN_B2 -to LEDG[8]
set_location_assignment PIN_B1 -to LEDG[9]

# --------------------------------------------------------------------------
# IO_STANDARD - 3.3-V LVTTL everywhere (matches both DE1's convention and
# DE0's GPIO header voltage)
# --------------------------------------------------------------------------
set_instance_assignment -name IO_STANDARD LVTTL -to MSX_CLK
set_instance_assignment -name IO_STANDARD LVTTL -to RESET_n
set_instance_assignment -name IO_STANDARD LVTTL -to CS1_n
set_instance_assignment -name IO_STANDARD LVTTL -to RD_n
