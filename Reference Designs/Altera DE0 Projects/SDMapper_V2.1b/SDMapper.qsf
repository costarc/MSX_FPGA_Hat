set_global_assignment -name FAMILY "Cyclone III"
set_global_assignment -name DEVICE EP3C16F484C6
set_global_assignment -name TOP_LEVEL_ENTITY SDMapper_TOP
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "21:36:31  JANUARY 15, 2023"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
# --------------------------------------------------------------------------
# DE0 GPIO_1 (J5) - MSX bus (IDC1 on MSX_FPGA_Hat), same 36-signal set and
# header-pin order as the DE1 version. Verified pin-by-pin against the DE0
# GPIO_1 fitter-confirmed direction table (pinmap.py) - zero direction
# conflicts. Pin 21 (INT_n) lands on GPIO1_CLKOUT[1] (PIN_T16), a pin
# community-flagged as unreliable on real DE0 boards; direction (out) is
# safe either way, and INT_n is hardwired to a constant '0' in this design
# (MSX interrupts are not used), so this is expected to be harmless.
# --------------------------------------------------------------------------
set_location_assignment PIN_AB11 -to MSX_CLK
set_location_assignment PIN_AA20 -to RESET_n
set_location_assignment PIN_AA11 -to CS1_n
set_location_assignment PIN_AB20 -to RD_n
set_location_assignment PIN_AA19 -to WAIT_n
set_location_assignment PIN_AB19 -to CS2_RFSH_n
set_location_assignment PIN_AB18 -to SOUNDIN
set_location_assignment PIN_AA18 -to SOUNDOUT
set_location_assignment PIN_AA17 -to M1_n
set_location_assignment PIN_AB17 -to U4OE_n
set_location_assignment PIN_Y17 -to MREQ_n
set_location_assignment PIN_W17 -to SLTSL_n
set_location_assignment PIN_U15 -to WR_n
set_location_assignment PIN_T15 -to IORQ_n
set_location_assignment PIN_W15 -to A_MUX[4]
set_location_assignment PIN_V15 -to U3OE_n
set_location_assignment PIN_R16 -to BUSDIR_n
set_location_assignment PIN_AB9 -to A_MUX[5]
set_location_assignment PIN_T16 -to INT_n
set_location_assignment PIN_AA9 -to A_MUX[2]
set_location_assignment PIN_AA7 -to A_MUX[3]
set_location_assignment PIN_AB7 -to U2OE_n
set_location_assignment PIN_T14 -to A_MUX[1]
set_location_assignment PIN_R14 -to A_MUX[0]
set_location_assignment PIN_U12 -to A_MUX[7]
set_location_assignment PIN_T12 -to A_MUX[6]
set_location_assignment PIN_R11 -to D[6]
set_location_assignment PIN_R12 -to D[7]
set_location_assignment PIN_U10 -to D[4]
set_location_assignment PIN_T10 -to D[5]
set_location_assignment PIN_U9 -to D[2]
set_location_assignment PIN_T9 -to D[3]
set_location_assignment PIN_Y7 -to U1_DIR
set_location_assignment PIN_U8 -to U1OE_n
set_location_assignment PIN_V6 -to D[1]
set_location_assignment PIN_V7 -to D[0]

# --------------------------------------------------------------------------
# DE0 GPIO_0 (J4) - SRAM addon board (J1 on DE0_Addon_Board, ISSI
# IS61LV25616AL). Signal names reflect actual function (SRAM_CE_n/OE_n/
# WE_n/UB_n/LB_n), not the addon netlist's coincidentally MSX-style labels
# (BUSDIR_n/IORQ_n/RESET_n/OE_n/P36) - see SDMapper_Top.vhd header comment.
# Verified against the DE0 GPIO_0 fitter-confirmed direction table - zero
# direction conflicts (the two DE0-input-only pins on this header land on
# unused addon pass-through pins, not on any real SRAM signal).
# --------------------------------------------------------------------------
set_location_assignment PIN_AB16 -to SRAM_ADDR[0]
set_location_assignment PIN_AA16 -to SRAM_ADDR[1]
set_location_assignment PIN_AA15 -to SRAM_ADDR[2]
set_location_assignment PIN_AB15 -to SRAM_ADDR[3]
set_location_assignment PIN_AB13 -to SRAM_ADDR[4]
set_location_assignment PIN_T8 -to SRAM_ADDR[5]
set_location_assignment PIN_W6 -to SRAM_ADDR[6]
set_location_assignment PIN_W7 -to SRAM_ADDR[7]
set_location_assignment PIN_U7 -to SRAM_ADDR[8]
set_location_assignment PIN_V5 -to SRAM_ADDR[9]
set_location_assignment PIN_U13 -to SRAM_ADDR[10]
set_location_assignment PIN_V12 -to SRAM_ADDR[11]
set_location_assignment PIN_Y13 -to SRAM_ADDR[12]
set_location_assignment PIN_W13 -to SRAM_ADDR[13]
set_location_assignment PIN_V14 -to SRAM_ADDR[14]
set_location_assignment PIN_AA5 -to SRAM_ADDR[15]
set_location_assignment PIN_AB8 -to SRAM_ADDR[16]
set_location_assignment PIN_AA10 -to SRAM_ADDR[17]
set_location_assignment PIN_AA14 -to SRAM_DQ[0]
set_location_assignment PIN_AA13 -to SRAM_DQ[1]
set_location_assignment PIN_AA8 -to SRAM_DQ[2]
set_location_assignment PIN_AB10 -to SRAM_DQ[3]
set_location_assignment PIN_V11 -to SRAM_DQ[4]
set_location_assignment PIN_R10 -to SRAM_DQ[5]
set_location_assignment PIN_W10 -to SRAM_DQ[6]
set_location_assignment PIN_Y10 -to SRAM_DQ[7]
set_location_assignment PIN_AB14 -to SRAM_CE_N
set_location_assignment PIN_AB5 -to SRAM_OE_N
set_location_assignment PIN_V8 -to SRAM_WE_N
set_location_assignment PIN_AB3 -to SRAM_LB_N
set_location_assignment PIN_AB4 -to SRAM_UB_N

# --------------------------------------------------------------------------
# DE0 onboard peripherals (dedicated pins, not GPIO)
# --------------------------------------------------------------------------
# Parallel Flash (byte-mode, 16-bit chip w/ FL_DQ15_AM1 as shared D15/A-1) -
# pin assignments carried over from the old DE0 SDMapper reference design,
# which already validated this chip's byte-mode wiring on real DE0 hardware.
set_location_assignment PIN_P7 -to FL_ADDR[0]
set_location_assignment PIN_P5 -to FL_ADDR[1]
set_location_assignment PIN_P6 -to FL_ADDR[2]
set_location_assignment PIN_N7 -to FL_ADDR[3]
set_location_assignment PIN_N5 -to FL_ADDR[4]
set_location_assignment PIN_N6 -to FL_ADDR[5]
set_location_assignment PIN_M8 -to FL_ADDR[6]
set_location_assignment PIN_M4 -to FL_ADDR[7]
set_location_assignment PIN_P2 -to FL_ADDR[8]
set_location_assignment PIN_N2 -to FL_ADDR[9]
set_location_assignment PIN_N1 -to FL_ADDR[10]
set_location_assignment PIN_M3 -to FL_ADDR[11]
set_location_assignment PIN_M2 -to FL_ADDR[12]
set_location_assignment PIN_M1 -to FL_ADDR[13]
