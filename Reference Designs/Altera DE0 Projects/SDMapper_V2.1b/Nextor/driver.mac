	; Device-based Nextor driver for SDMapper_V2.1b's XESS-core SD interface
	;
	; MSX_FPGA_Hat rev 2.1b (Terasic DE0). Talks to sdcard_bridge.vhd's
	; register window, which wraps a ported XESS Corp SdCardCtrl core
	; (github.com/xesscorp/VHDL_Lib/blob/master/SDCard.vhd) - all SD
	; protocol (CMD0/CMD8/ACMD41/CMD17/CMD24) runs in that hardware core;
	; this driver only ever does simple byte-level register I/O. Modeled
	; structurally on Nextor's own SunriseIDE driver.mac (jump table,
	; DRV_INIT flow, error-code conventions), but far simpler since there's
	; no low-level protocol bit-banging to do here.

	org 4100h

DRV_START:

	.print1 SDMapper V2.1b XESS SD driver

;-----------------------------------------------------------------------------
;
; Driver configuration constants

;Driver type: 0 for drive-based, 1 for device-based
DRV_TYPE	equ	1

;Hot-plug devices support: this board has no physical card-detect sensing
;(SW(0) is a manual switch), so no real hot-plug support.
DRV_HOTPLUG	equ	0

DEBUG	equ	0

;Driver version
VER_MAIN	equ	1
VER_SEC		equ	0
VER_REV		equ	0

;This driver has one important limitation, inherited from the underlying
;XESS core: only single-block-at-a-time addressing is exposed at the
;register level for the FIRST sector of a transfer, but the driver uses the
;core's own continue_i multi-block support for the rest, so multi-sector
;reads/writes ARE efficient (no re-issuing SD_ADDR0-3 per sector, matching
;how the sequential SD read/write commands work in hardware).


;-----------------------------------------------------------------------------
;
; SD card register window - see sdcard_bridge.vhd for the full protocol.
; Only visible when this cartridge's ROM bank 1 is switched to segment 7,
; which is exactly where mknexrom always places driver content (bank
; DRIVER_BANK = the kernel's own bank count, 7 for Nextor 2.1.x) - so these
; addresses are reachable any time this driver's own code is executing, no
; extra bank-switch needed.

SD_DATA		equ	7B00h	;R/W: next byte to/from an active block transfer (WAIT_n-gated)
SD_ADDR0	equ	7B01h	;W: block address bits 7:0
SD_ADDR1	equ	7B02h	;W: block address bits 15:8
SD_ADDR2	equ	7B03h	;W: block address bits 23:16
SD_ADDR3	equ	7B04h	;W: block address bits 31:24 (SDHC card - block number, not byte address)
SD_CMD		equ	7B05h	;W: bit7=reset pulse, bit1=write pulse, bit0=read pulse, bit2=continue
SD_STATUS	equ	7B06h	;R: bit0=busy, bit1=error, bit2=present, bit3=write-protect, bit4=bridge timeout
SD_ERRLO	equ	7B07h	;R: SdCardCtrl's error_o(7:0), for diagnostics
SD_ERRHI	equ	7B08h	;R: SdCardCtrl's error_o(15:8), for diagnostics
SD_DEBUG	equ	7B09h	;W: trace marker, shown on HEX3:HEX2 (see sdcard_bridge.vhd)	;R: SdCardCtrl's error_o(15:8), for diagnostics

SD_CMD_RESET	equ	80h
SD_CMD_READ		equ	01h
SD_CMD_WRITE	equ	02h
SD_CMD_CONTINUE	equ	04h

SDSTAT_BUSY		equ	0
SDSTAT_ERROR	equ	1
SDSTAT_PRESENT	equ	2
SDSTAT_WPROT	equ	3
SDSTAT_TIMEOUT	equ	4
SDSTAT_READY	equ	5	;SD_DATA ready: prefetched byte available / core ready to accept one

M_SDSTAT_BUSY		equ	(1 SHL SDSTAT_BUSY)
M_SDSTAT_ERROR		equ	(1 SHL SDSTAT_ERROR)
M_SDSTAT_PRESENT	equ	(1 SHL SDSTAT_PRESENT)
M_SDSTAT_WPROT		equ	(1 SHL SDSTAT_WPROT)
M_SDSTAT_TIMEOUT	equ	(1 SHL SDSTAT_TIMEOUT)
M_SDSTAT_READY		equ	(1 SHL SDSTAT_READY)
M_SDSTAT_FAIL		equ	M_SDSTAT_ERROR+M_SDSTAT_TIMEOUT	;either bit means "something went wrong"


;-----------------------------------------------------------------------------
;
; Standard BIOS and work area entries

CHPUT	equ	00A2h	;Character output


;-----------------------------------------------------------------------------
;
; Error codes for DEV_RW and DEV_FORMAT (same codes MSX-DOS uses)

.NCOMP	equ	0FFh
.WRERR	equ	0FEh
.DISK	equ	0FDh
.NRDY	equ	0FCh
.DATA	equ	0FAh
.RNF	equ	0F9h
.WPROT	equ	0F8h
.UFORM	equ	0F7h
.SEEK	equ	0F3h
.IFORM	equ	0F0h
.IDEVL	equ	0B5h
.IPARM	equ	08Bh


;-----------------------------------------------------------------------------
;
; Routines available on kernel page 0

GSLOT1	equ	402Dh
RDBANK	equ	403Ch
CALBAS	equ	403Fh
CALBNK	equ	4042h
GWORK	equ	4045h
CALDRV	equ	4048h


;-----------------------------------------------------------------------------
;
; Driver signature

	db	"NEXTOR_DRIVER",0

;Driver flags: bit0=1 device-based, bit1=hotplug, bit2=1 (provides DRV_CONFIG)
	db	1+(2*DRV_HOTPLUG)+4

;Reserved byte
	db	0

;Driver name

DRV_NAME:
	db	"SDMapper V2.1b (XESS SD core)"
	ds	32-($-DRV_NAME)," "

;Jump table

	jp	DRV_TIMI
	jp	DRV_VERSION
	jp	DRV_INIT
	jp	DRV_BASSTAT
	jp	DRV_BASDEV
	jp	DRV_EXTBIO
	jp	DRV_DIRECT0
	jp	DRV_DIRECT1
	jp	DRV_DIRECT2
	jp	DRV_DIRECT3
	jp	DRV_DIRECT4
	jp	DRV_CONFIG

	ds	12

	jp	DEV_RW
	jp	DEV_INFO
	jp	DEV_STATUS
	jp	LUN_INFO
	jp	DEV_FORMAT
	jp	DEV_CMD


;-----------------------------------------------------------------------------
;
; Timer interrupt routine - not used by this driver.

DRV_TIMI:
	ret


;-----------------------------------------------------------------------------
;
; Driver initialization, called twice (see the Driver Development Guide for
; the full first/second-execution contract) - this driver needs no work
; area, so both executions just check/report the SD card's own state.
; SdCardCtrl's own CMD0/CMD8/ACMD41 sequence runs automatically from power-
; on/FPGA-configuration reset, independent of this routine - by the time
; DRV_INIT runs, initialization has typically already completed (or
; failed), so this mostly just reports what already happened, with a
; software reset pulse + a bounded wait as a safety net in case it hasn't.

TEMP_WORK	equ	0C000h
BOOTSIG0	equ	0C000h	;one scratch byte in page-3 RAM, used only during DRV_INIT

DRV_INIT:
	or	a
	ld	hl,0
	ld	a,2
	ret	z			;first execution: no work area needed, no timer hook

	ld	de,INFO_S
	call	PRINT

	;Pulse a software reset - cheap insurance so a soft MSX reset also
	;retries card detection, not just a full power cycle.
	ld	a,SD_CMD_RESET
	ld	(SD_CMD),a

	;Poll SD_STATUS for busy to clear. This is a genuine software polling
	;loop (SD_STATUS is an immediate/non-WAIT_n-gated read - see
	;sdcard_bridge.vhd) - same shape as the abandoned protocol's
	;WAIT_RESP-style loops, just watching a different bit.
	;
	;BUG FIX (2026-08-13): the bound here was ~180ms (256 outer x 256 inner
	;iterations at a handful of T-states each - the old "~300ms" comment
	;overestimated it). That is NOT enough: the SD spec allows a card up to
	;1 SECOND to finish initialization, and the reset pulse just issued above
	;makes SdCardCtrl restart its whole CMD0/CMD8/ACMD41 sequence, so this
	;wait is timing a fresh init every boot - not the already-completed
	;power-on one. A card that needed longer than the old bound was declared
	;"initialization failed", after which Nextor skips the device entirely
	;and boots straight to BASIC without ever calling DEV_RW - matching the
	;"stable, but never mounts the card" symptom. Outer counter added for a
	;~1.4s bound, comfortably past the spec's 1s worst case.
	ld	d,8
DRV_INIT_WAIT_OUTER:
	ld	b,0
DRV_INIT_WAIT:
	ld	a,(SD_STATUS)
	bit	SDSTAT_BUSY,a
	jr	z,DRV_INIT_WAITDONE
	ld	c,0
DRV_INIT_WAIT_INNER:
	dec	c
	jr	nz,DRV_INIT_WAIT_INNER
	djnz	DRV_INIT_WAIT
	dec	d
	jr	nz,DRV_INIT_WAIT_OUTER
DRV_INIT_WAITDONE:

	ld	a,(SD_STATUS)
	ld	c,a			;save status for the checks below

	;jp (not jr) - the self-test below grew these targets out of relative range
	bit	SDSTAT_PRESENT,c
	jp	z,DRV_INIT_NOCARD

	bit	SDSTAT_BUSY,c
	jp	nz,DRV_INIT_FAIL	;still busy after the wait above - treat as failure

	ld	a,(SD_ERRLO)
	or	a
	jp	nz,DRV_INIT_FAIL
	ld	a,(SD_ERRHI)
	or	a
	jp	nz,DRV_INIT_FAIL

	ld	de,OK_S
	call	PRINT

	;-------------------------------------------------------------------
	; SELF-TEST (2026-08-15): read sector 0 ourselves and verify the
	; 55 AA boot signature at offsets 510/511.
	;
	; Purpose: separate "the byte path delivers wrong data" from "the byte
	; path is fine and something else is wrong". If bytes are wrong, Nextor
	; faithfully writes that garbage into its own structures, which looks
	; like memory corruption (tiny free RAM, Syntax Error loops) without any
	; bus-level RAM damage at all. This runs before Nextor touches the
	; device, costs one sector read, and answers that directly.
	;
	; Reads the whole sector, keeping only the last two bytes - no buffer
	; needed, so nothing else in memory is disturbed by the test itself.
	;-------------------------------------------------------------------
	xor	a
	ld	(SD_ADDR0),a
	ld	(SD_ADDR1),a
	ld	(SD_ADDR2),a
	ld	(SD_ADDR3),a
	ld	a,SD_CMD_READ
	ld	(SD_CMD),a

	call	SD_WAIT_READY
	jp	c,DRV_INIT_TESTBAD	;jp: the dump loop below pushed this out of jr range

	ld	bc,512
	ld	d,0			;d = previous byte (ends up as offset 510)
	ld	e,0			;e = current  byte (ends up as offset 511)
	ld	hl,0			;hl = byte index within the sector
DRV_INIT_TESTLOOP:
	ld	a,(SD_DATA)
	ld	d,e
	ld	e,a

	;Dump the FIRST MBR PARTITION ENTRY (offsets 446..461 = 0x1BE..0x1CD).
	;
	;55AA at the end of the sector only proves 2 bytes of 512 arrived intact.
	;The core now reports no error and no timeout, yet Nextor still refuses to
	;mount - so the question is whether the DATA is right, or whether we are
	;describing the device wrongly. The partition entry answers the first half
	;directly: byte 4 of it is the partition TYPE (01/04/06/0E = FAT12/16,
	;00 = empty) and bytes 8..11 are the start LBA. If those read sensibly,
	;the sector content is genuinely correct and the fault is in what this
	;driver TELLS Nextor (LUN_INFO capacity, DEV_STATUS, ...) rather than in
	;what it reads.
	ld	a,h
	cp	1
	jr	nz,DRV_INIT_TESTNEXT
	ld	a,l
	cp	0BEh
	jr	c,DRV_INIT_TESTNEXT
	cp	0CEh
	jr	nc,DRV_INIT_TESTNEXT
	ld	a,e			;the byte just read
	call	PRINTHEX
DRV_INIT_TESTNEXT:
	inc	hl

	dec	bc
	ld	a,b
	or	c
	jr	nz,DRV_INIT_TESTLOOP

	push	de
	ld	de,CRLF_S
	call	PRINT
	pop	de

	ld	a,(SD_STATUS)
	and	M_SDSTAT_FAIL
	jp	nz,DRV_INIT_TESTBAD	;jp: the readback block below pushed these out of jr range

	ld	a,d
	cp	55h
	jp	nz,DRV_INIT_TESTBAD
	ld	a,e
	cp	0AAh
	jp	nz,DRV_INIT_TESTBAD

	ld	de,TESTOK_S
	call	PRINT

	;-------------------------------------------------------------------
	; SELF-TEST PART 2 (2026-08-15): the MULTI-SECTOR / CONTINUE path.
	;
	; Part 1 above reads a single sector and passes on real hardware, but
	; Nextor reads several sectors per call and uses SD_CMD_READ+CONTINUE
	; for every sector after the first. Nothing has ever verified that
	; path, and the bridge-timeout flag (LEDG0) is now being seen set on
	; real hardware - which is exactly what a stalled CONTINUE would look
	; like: the CPU reads SD_DATA, no byte ever arrives, the 100us guard
	; fires and the data is garbage from there on.
	;
	; So: issue CONTINUE for the next sequential sector and read it. We do
	; not know its contents, so this checks only that the transfer COMPLETES
	; - ready bit rises, all 512 bytes clock through, no error, no timeout.
	; That is precisely the thing in doubt.
	;-------------------------------------------------------------------
	;Sector 1 via a FRESH single-block command - the same path DEV_RW now
	;uses for every sector (see the DESIGN CHANGE note there).
	ld	a,1
	ld	(SD_ADDR0),a
	xor	a
	ld	(SD_ADDR1),a
	ld	(SD_ADDR2),a
	ld	(SD_ADDR3),a

	;Read the address registers back BEFORE issuing the command. Sector 0 is
	;read with address 00 00 00 00, which is the registers' reset default, so
	;it succeeds whether or not the writes land - sector 1 is the first read
	;that depends on SD_ADDR0 actually holding 01. Expect "01000000"; anything
	;else means the address write path is the fault, not the card or the core.
	ld	de,ADDRDUMP_S
	call	PRINT
	ld	a,(SD_ADDR0)
	call	PRINTHEX
	ld	a,(SD_ADDR1)
	call	PRINTHEX
	ld	a,(SD_ADDR2)
	call	PRINTHEX
	ld	a,(SD_ADDR3)
	call	PRINTHEX
	ld	de,CRLF_S
	call	PRINT

	ld	a,SD_CMD_READ
	ld	(SD_CMD),a

	call	SD_WAIT_READY
	jr	c,DRV_INIT_MULTIBAD

	;Sector 1 is where the MBR says the FAT16 partition starts, so this is
	;the partition's BOOT SECTOR. Until now this test only checked that the
	;transfer completed - never what came back. If this sector is garbage,
	;Nextor reads the MBR fine, rejects the partition it points to, and drops
	;to BASIC: exactly the behaviour being seen. Dump the first 16 bytes (a
	;FAT boot sector starts with a jump, EB xx 90 or E9 xx xx, then an 8-char
	;OEM name) and check its own 55AA signature at 510/511.
	ld	bc,512
	ld	d,0
	ld	e,0
	ld	hl,0
DRV_INIT_MULTILOOP:
	ld	a,(SD_DATA)
	ld	d,e
	ld	e,a

	ld	a,h
	or	a
	jr	nz,DRV_INIT_MULTINEXT
	ld	a,l
	cp	16
	jr	nc,DRV_INIT_MULTINEXT
	ld	a,l
	or	a
	jr	nz,DRV_INIT_MULTISHOW
	ld	a,e
	ld	(BOOTSIG0),a		;stash byte 0 for the jump-instruction check
DRV_INIT_MULTISHOW:
	ld	a,e
	call	PRINTHEX
DRV_INIT_MULTINEXT:
	inc	hl

	dec	bc
	ld	a,b
	or	c
	jr	nz,DRV_INIT_MULTILOOP

	push	de
	ld	de,CRLF_S
	call	PRINT
	pop	de

	ld	a,(SD_STATUS)
	and	M_SDSTAT_FAIL
	jr	nz,DRV_INIT_MULTIBAD

	;Sector 1 is the partition's FAT BOOT SECTOR, not an MBR. Requiring 55AA
	;at offsets 510/511 was simply wrong - Nextor's own FAT16 boot sectors do
	;not necessarily carry it, so a perfectly good sector was reported BAD.
	;Real hardware showed EB FE 90 "NEXTOR20" 00 02 80 01 00 - a textbook FAT
	;boot sector - being rejected by this check. Validate what actually
	;identifies one: the leading jump instruction, EB xx 90 or E9 xx xx.
	ld	a,(BOOTSIG0)
	cp	0EBh
	jr	z,DRV_INIT_MULTIOK
	cp	0E9h
	jr	nz,DRV_INIT_MULTIBAD
DRV_INIT_MULTIOK:

	ld	de,MULTIOK_S
	call	PRINT

	;MARKER (2026-08-15): the machine hangs immediately after the self-test
	;messages. This distinguishes "DRV_INIT itself died in its tail" from
	;"DRV_INIT returned cleanly and Nextor hung afterwards" - two completely
	;different investigations. If this line appears, the driver's init path
	;is fully complete and the fault is in what Nextor does next.
	ld	de,INITDONE_S
	call	PRINT
	ret

DRV_INIT_MULTIBAD:
	ld	de,MULTIBAD_S
	call	PRINT

	;-------------------------------------------------------------------
	; BYTE-ADDRESSING PROBE (2026-08-16).
	;
	; SD_ADDR read back as 01000000, so the address register latched
	; correctly and the command really did carry block 1 - yet the card
	; returned all FF. That leaves the ADDRESSING MODE: SdCardCtrl is
	; compiled with CARD_TYPE_G = SDHC_CARD_E and therefore always sends
	; CMD17 a BLOCK number, while a standard-capacity (SDSC, <=2GB) card
	; expects a BYTE address. The two are identical at sector 0 (address 0
	; either way) and diverge immediately at sector 1: block 1 vs byte 512.
	; That is precisely the observed pattern.
	;
	; So: ask for address 512. On a byte-addressed card that IS logical
	; sector 1 and should return the FAT boot sector; on a block-addressed
	; card it is sector 512 and almost certainly is not a boot sector.
	;-------------------------------------------------------------------
	xor	a
	ld	(SD_ADDR0),a
	ld	a,2			;0x00000200 = 512
	ld	(SD_ADDR1),a
	xor	a
	ld	(SD_ADDR2),a
	ld	(SD_ADDR3),a
	ld	a,SD_CMD_READ
	ld	(SD_CMD),a

	call	SD_WAIT_READY
	jp	c,DRV_INIT_BYTEBAD

	ld	bc,512
	ld	d,0
	ld	e,0
	ld	hl,0
DRV_INIT_BYTELOOP:
	ld	a,(SD_DATA)
	ld	d,e
	ld	e,a
	ld	a,h
	or	a
	jr	nz,DRV_INIT_BYTENEXT
	ld	a,l
	cp	16
	jr	nc,DRV_INIT_BYTENEXT
	ld	a,e
	call	PRINTHEX
DRV_INIT_BYTENEXT:
	inc	hl
	dec	bc
	ld	a,b
	or	c
	jr	nz,DRV_INIT_BYTELOOP

	push	de
	ld	de,CRLF_S
	call	PRINT
	pop	de

	ld	a,d
	cp	55h
	jp	nz,DRV_INIT_BYTEBAD
	ld	a,e
	cp	0AAh
	jp	nz,DRV_INIT_BYTEBAD

	ld	de,BYTEOK_S
	call	PRINT
	ret

DRV_INIT_BYTEBAD:
	ld	de,BYTEBAD_S
	call	PRINT
	ret

DRV_INIT_TESTBAD:
	ld	de,TESTBAD_S
	call	PRINT
	ret

DRV_INIT_NOCARD:
	ld	de,NOCARD_S
	call	PRINT
	ret

DRV_INIT_FAIL:
	ld	de,FAIL_S
	call	PRINT
	ret


;-----------------------------------------------------------------------------
;
; Obtain driver version

DRV_VERSION:
	ld	a,VER_MAIN
	ld	b,VER_SEC
	ld	c,VER_REV
	ret


;-----------------------------------------------------------------------------
;
; BASIC expanded statement/device handlers - not implemented.

DRV_BASSTAT:
	scf
	ret

DRV_BASDEV:
	scf
	ret


;-----------------------------------------------------------------------------
;
; Extended BIOS hook - not used.

DRV_EXTBIO:
	ret


;-----------------------------------------------------------------------------
;
; Direct calls entry points - not used.

DRV_DIRECT0:
DRV_DIRECT1:
DRV_DIRECT2:
DRV_DIRECT3:
DRV_DIRECT4:
	ret


;-----------------------------------------------------------------------------
;
; Get driver configuration - this driver always uses the kernel's default
; (2 drives for a device-based driver), so it reports "not available" for
; every index, same simplification Nextor's own SunriseIDE driver uses.

DRV_CONFIG:
	ld	a,1
	ret


;=====
;=====  BEGIN of DEVICE-BASED specific routines
;=====

;-----------------------------------------------------------------------------
;
; Read or write logical sectors from/to a logical unit
;
;Input:    Cy=0 to read, 1 to write
;          A = Device number, 1 to 7 (always 1 - this board has one SD slot)
;          B = Number of sectors to read or write
;          C = Logical unit number, 1 to 7 (always 1)
;          HL = Source or destination memory address for the transfer
;          DE = Address where the 4 byte sector number is stored
;Output:   A = Error code (MSX-DOS codes, see equates above)
;          B = Number of sectors actually read or written

DEV_RW:
	;Trace marker via hardware, NOT via CHPUT. The BIOS entry at 00A2h is
	;only valid while page 0 still holds the BIOS - true during DRV_INIT,
	;but not once Nextor is running, so a print-based trace can hang the
	;very thing it is measuring. This is a plain register write.
	push	af
	ld	a,'R'
	ld	(SD_DEBUG),a
	pop	af
	push	af			;save Cy(r/w) + A(device index)

	ld	a,c			;LUN must be 1 (only one LUN on this device)
	cp	1
	jp	nz,DEV_RW_BADDEV

	;BUG FIX (2026-08-13, real hardware: with no card inserted, DRV_INIT
	;correctly reported failure and the DEV_STATUS fix above should have
	;kept the kernel from mounting the device - but it still hung).
	;Root cause: DRV_HOTPLUG=0, and with hotplug disabled Nextor's kernel
	;apparently calls DEV_RW directly (to probe for a boot sector/DPB)
	;without ever consulting DEV_STATUS first - so that fix alone never
	;got a chance to run. Whatever the kernel's calling convention turns
	;out to be, DEV_RW itself must never blindly enter the WAIT_n-gated
	;SD_DATA loop below against a card that isn't genuinely ready - the
	;stalled SdCardCtrl core (REPORT_ERROR, no card ever responded to
	;CMD0) will never issue the handshake it's waiting for. Same health
	;check as DEV_STATUS/DRV_INIT: present, not busy, no error latched.
	;NOTE: must not touch DE/BC/HL/IX here - DE carries the caller's
	;sector-number pointer, needed intact by DEV_RW_HASCOUNT below (a
	;prior version of this fix used E as scratch and silently corrupted
	;that pointer - A is the only register safe to clobber here).
	;Bail WITHOUT resetting for the transient/benign conditions (no card, or
	;the core is simply still busy) - see DEV_RW_NOTREADY. Only a LATCHED
	;error gets the reset, via DEV_RW_NOTREADY_ERR.
	ld	a,(SD_STATUS)
	bit	SDSTAT_PRESENT,a
	jp	z,DEV_RW_NOTREADY
	ld	a,(SD_STATUS)
	bit	SDSTAT_BUSY,a
	jp	nz,DEV_RW_NOTREADY
	ld	a,(SD_ERRLO)
	or	a
	jp	nz,DEV_RW_NOTREADY_ERR
	ld	a,(SD_ERRHI)
	or	a
	jp	nz,DEV_RW_NOTREADY_ERR

	ld	a,b
	or	a
	jr	nz,DEV_RW_HASCOUNT
	pop	af
	xor	a
	ld	b,0
	ret				;0 sectors requested - trivially ok

DEV_RW_HASCOUNT:
	push	de
	pop	ix			;ix -> 4-byte sector number
	ld	e,0			;e = sector offset within this request (0,1,2,...)

	;BUG FIX (2026-08-15): Nextor's contract is "B = number of sectors
	;actually read/written" on return. Both loops below use DJNZ on B, so B
	;is ZERO by the time they succeed - the driver was reporting "no error,
	;and I transferred no sectors". Nextor takes that as a failed read, gives
	;up on the device and boots to BASIC. Present since the first version of
	;this driver, but masked by the larger failures upstream of it.
	;C is free here (the LUN was validated above), so keep the count there
	;and restore B before every successful return. The inner byte loops
	;already push/pop BC, so C survives them.
	ld	c,b

	pop	af			;Cy = r/w flag again
	jr	c,DEV_RW_DOWRITE

;--- READ ---
;
; DESIGN CHANGE (2026-08-15): one FRESH single-block command per sector,
; instead of one command plus SD_CMD_CONTINUE for the rest.
;
; On real hardware the single-block path is rock solid - the DRV_INIT
; self-test has read sector 0 correctly on every build for a long time -
; while the CONTINUE path fails: no data ever arrives, no error is raised
; and no bridge timeout fires, so the driver just waits out its poll.
; CONTINUE is only an optimisation (it saves re-sending CMD17), so it is
; not worth blocking a working system on. Cost is one extra command per
; sector, i.e. one extra start-token latency; correctness first.

DEV_RW_RLOOP:
	call	SD_SET_ADDR		;SD_ADDR0-3 = (ix) + e
	ld	a,SD_CMD_READ
	ld	(SD_CMD),a
	;Wait for the first byte of this block WITHOUT stalling the bus.
	;
	;CRITICAL (2026-08-15): the card can take milliseconds to produce its
	;start token after CMD17, and that wait must NOT happen with /WAIT
	;asserted. On MSX the Z80's refresh cycles are what refresh main DRAM
	;(the CS2_RFSH_n line); a frozen CPU means no refresh, and DRAM only
	;retains for ~2-4ms. Stalling the bus that long physically corrupts
	;main RAM - observed on real hardware as a corrupted boot logo, RAM
	;detected as 8KB instead of 32KB, and random restarts.
	;
	;So the bridge now prefetches in the background and we poll a plain
	;register bit here. This loop is ordinary CPU execution: interrupts and
	;refresh keep running throughout.
	call	SD_WAIT_READY
	jr	c,DEV_RW_ERR		;timed out or the core reported an error
	push	bc
	ld	bc,512
DEV_RW_RBYTE:
	ld	a,(SD_DATA)
	ld	(hl),a
	inc	hl
	dec	bc
	ld	a,b
	or	c
	jr	nz,DEV_RW_RBYTE
	pop	bc

	ld	a,(SD_STATUS)
	and	M_SDSTAT_FAIL
	jr	nz,DEV_RW_ERR

	inc	e			;next sector
	djnz	DEV_RW_RLOOP
	ld	b,c			;report the sector count Nextor asked for
	ld	a,'O'			;marker: DEV_RW returned SUCCESS
	ld	(SD_DEBUG),a
	xor	a
	ret

;--- WRITE ---

DEV_RW_DOWRITE:
	ld	a,(SD_STATUS)
	bit	SDSTAT_WPROT,a
	jr	nz,DEV_RW_WPROTERR

DEV_RW_WLOOP:
	call	SD_SET_ADDR		;fresh single-block command per sector - see the read path
	ld	a,SD_CMD_WRITE
	ld	(SD_CMD),a
	call	SD_WAIT_READY		;see the note in the read path above
	jr	c,DEV_RW_ERR
	push	bc
	ld	bc,512
DEV_RW_WBYTE:
	ld	a,(hl)
	ld	(SD_DATA),a
	inc	hl
	dec	bc
	ld	a,b
	or	c
	jr	nz,DEV_RW_WBYTE
	pop	bc

	ld	a,(SD_STATUS)
	and	M_SDSTAT_FAIL
	jr	nz,DEV_RW_ERR

	inc	e			;next sector
	djnz	DEV_RW_WLOOP
	ld	b,c			;report the sector count Nextor asked for
	ld	a,'O'			;marker: DEV_RW returned SUCCESS
	ld	(SD_DEBUG),a
	xor	a
	ret

;--- Error handling ---

;Benign/transient not-ready: no card, or the core is simply still busy.
;Must NOT reset here - busy clears on its own, and resetting restarts
;SdCardCtrl's whole ~1s init sequence. An earlier version of this fix reset
;on ANY not-ready condition, which produced a reset STORM on real hardware:
;Nextor calls DEV_RW -> core busy -> bail and reset -> core restarts init ->
;next call finds it busy -> reset again, forever. The machine was not
;crashed so much as trapped in that retry loop, which presented as "very
;unstable, hangs at different stages".
DEV_RW_NOTREADY:
	pop	af			;balance the push af at DEV_RW's entry
	ld	a,.NRDY
	ld	(SD_DEBUG),a		;marker: the exact code returned to Nextor
	ld	b,0
	ret

;Latched error: SdCardCtrl stalls in its REPORT_ERROR state until reset (its
;own documented behaviour), and the entry health check refuses to proceed
;while the error flag is set - so without a reset here, one transient error
;would wedge the driver permanently: every later DEV_RW call bails out and
;the core never recovers. Unlike busy, this genuinely cannot clear by
;itself, so the reset is both safe and required.
DEV_RW_NOTREADY_ERR:
	pop	af			;balance the push af at DEV_RW's entry
	ld	a,SD_CMD_RESET
	ld	(SD_CMD),a
	ld	a,.NRDY
	ld	(SD_DEBUG),a		;marker: the exact code returned to Nextor
	ld	b,0
	ret

DEV_RW_ERR:
	push	af
	ld	a,SD_CMD_RESET		;recover SdCardCtrl - it stalls on error until reset (its own documented behaviour)
	ld	(SD_CMD),a
	pop	af

	bit	SDSTAT_TIMEOUT,a
	jr	nz,DEV_RW_ERR_NRDY
	ld	a,.DISK
	ld	(SD_DEBUG),a		;marker: the exact code returned to Nextor
	ld	b,0
	ret
DEV_RW_ERR_NRDY:
	ld	a,.NRDY
	ld	(SD_DEBUG),a		;marker: the exact code returned to Nextor
	ld	b,0
	ret

DEV_RW_WPROTERR:
	ld	a,.WPROT
	ld	(SD_DEBUG),a		;marker: the exact code returned to Nextor
	ld	b,0
	ret

DEV_RW_BADDEV:
	pop	af
	ld	a,.IDEVL
	ld	(SD_DEBUG),a		;marker: the exact code returned to Nextor
	ld	b,0
	ret


;-----------------------------------------------------------------------------
;
; Device information gathering
;
;Input:   A = Device index, 1 to 7
;         B = Information to return: 0=basic, 1=manufacturer, 2=device name, 3=serial
;         HL = Pointer to a buffer in RAM
;Output:  A = 0 Ok, 1 device/index invalid, 2 information not available
;         Buffer filled per the Driver Development Guide's DEV_INFO contract.

DEV_INFO:
	;No trace marker here any more: these routines are called constantly and
	;their markers overwrote DEV_RW's RESULT code, which is the value that
	;actually matters now. HEX3:HEX2 is reserved for DEV_RW's outcome.
	or	a
	jr	z,DEV_INFO_ERR1
	cp	2
	jr	nc,DEV_INFO_ERR1

	ld	a,b
	or	a
	jr	nz,DEV_INFO_STRING

	ld	(hl),1			;one LUN
	inc	hl
	ld	(hl),0			;flags always zero
	xor	a
	ret

DEV_INFO_STRING:
	push	bc
	push	hl
	push	hl
	pop	de
	inc	de
	ld	(hl)," "
	ld	bc,64-1
	ldir
	pop	hl
	pop	bc

	ld	a,b
	cp	2
	jr	nz,DEV_INFO_ERR2	;only "device name" (index 2) is provided

	ld	de,DEVNAME_S
	ld	bc,DEVNAME_LEN
	ldir
	xor	a
	ret

DEV_INFO_ERR1:
	ld	a,1
	ret
DEV_INFO_ERR2:
	ld	a,2
	ret


;-----------------------------------------------------------------------------
;
; Obtain device status
;
;Input:   A = Device index, 1 to 7
;         B = Logical unit number, 1 to 7 (0 = the device itself)
;Output:  A = 0 not available/invalid, 1 available unchanged,
;             2 available changed, 3 available unknown-change
;
; This board has no physical card-detect sensing (SW(0) is a manual
; switch), so no real hot-plug/change tracking - always "unchanged" while
; SW(0) reports the card present.
;
; BUG FIX (2026-08-13, real hardware: with no card inserted, DRV_INIT
; correctly detected and reported "SD card initialization failed", but the
; MSX still hung afterwards instead of falling through to BASIC). Root
; cause: this only ever checked SDSTAT_PRESENT, which is just the SW(0)
; manual switch - it says nothing about whether SdCardCtrl actually
; finished initializing. So even after DRV_INIT reported failure (core
; stalled in its own REPORT_ERROR state after exhausting CMD0 retries),
; DEV_STATUS still told Nextor's kernel the device was "available",
; and the kernel went ahead and tried to mount/read it anyway - DEV_RW's
; WAIT_n-gated SD_DATA read then blocks waiting for a handshake the
; stalled core will never issue. Now also requires SD_ERRLO/SD_ERRHI to
; both read zero (matching DRV_INIT's own success check) before reporting
; the device available, so the kernel skips mounting it entirely and
; boots straight to BASIC - letting the user run FDISK on a fresh card.

DEV_STATUS:
	;No trace marker here any more: these routines are called constantly and
	;their markers overwrote DEV_RW's RESULT code, which is the value that
	;actually matters now. HEX3:HEX2 is reserved for DEV_RW's outcome.
	or	a
	jr	z,DEV_STATUS_NA
	cp	2
	jr	nc,DEV_STATUS_NA
	ld	a,b
	cp	2
	jr	nc,DEV_STATUS_NA

	ld	a,(SD_STATUS)
	bit	SDSTAT_PRESENT,a
	jr	z,DEV_STATUS_NA

	ld	a,(SD_ERRLO)
	or	a
	jr	nz,DEV_STATUS_NA
	ld	a,(SD_ERRHI)
	or	a
	jr	nz,DEV_STATUS_NA

	ld	a,1
	ret
DEV_STATUS_NA:
	xor	a
	ret


;-----------------------------------------------------------------------------
;
; Obtain logical unit information
;
;Input:   A = Device index, 1 to 7
;         B = Logical unit number, 1 to 7
;         HL = Pointer to buffer in RAM
;Output:  A = 0 Ok / 1 error
;
; Capacity is unknown (this driver doesn't parse the SD card's CSD
; register) - reported as 0, the documented "not available" value.

LUN_INFO:
	;No trace marker here any more: these routines are called constantly and
	;their markers overwrote DEV_RW's RESULT code, which is the value that
	;actually matters now. HEX3:HEX2 is reserved for DEV_RW's outcome.
	or	a
	jr	z,LUN_INFO_ERR
	cp	2
	jr	nc,LUN_INFO_ERR
	ld	a,b
	cp	1
	jr	nz,LUN_INFO_ERR

	push	hl
	pop	ix
	ld	(ix+0),0		;block device
	ld	(ix+1),0		;sector size = 512
	ld	(ix+2),2

	;BUG FIX (2026-08-15, real hardware: Nextor printed "drive @:" six times
	;on boot - '@' is 'A'-1, i.e. drive index 0). Total sectors was reported
	;as 0 here. Nextor needs a non-zero device size to validate the partitions
	;it finds in the MBR and assign them drive letters; with 0 it cannot map
	;anything and emits garbage drive entries instead.
	;
	;The XESS core does not expose the card's CSD register, so the true
	;capacity is not available to this driver. Reporting a large fixed size is
	;the pragmatic answer: partitions are defined by the MBR, and a real MBR
	;never describes sectors beyond the physical card, so anything Nextor
	;actually mounts stays in range. The value below is 0x02000000 sectors
	;(32GB at 512 bytes/sector), comfortably above any card this board is
	;likely to see.
	;
	;TRADE-OFF, stated plainly: the reported size is NOT the real one. Tools
	;that trust it - notably FDISK when creating a fresh partition table -
	;could offer to lay out more space than the card physically has. Reading
	;the CSD (CMD9) would be the correct long-term fix, but that needs core
	;support this bridge does not currently have.
	ld	(ix+3),0		;total sectors = 0x02000000 (little-endian)
	ld	(ix+4),0
	ld	(ix+5),0
	ld	(ix+6),2
	ld	(ix+7),0		;not removable, not read-only, not a floppy
	ld	(ix+8),0		;cylinders = 0 (not applicable)
	ld	(ix+9),0
	ld	(ix+10),0		;heads = 0
	ld	(ix+11),0		;sectors/track = 0
	xor	a
	ret

LUN_INFO_ERR:
	ld	a,1
	ret


;-----------------------------------------------------------------------------
;
; Physical format - not supported.

DEV_FORMAT:
	ld	a,.IFORM
	ret


;-----------------------------------------------------------------------------
;
; Direct device command - not supported.

DEV_CMD:
	ld	a,2
	ret

;=====
;=====  END of DEVICE-BASED specific routines
;=====


;=======================
; Subroutines
;=======================

;-----------------------------------------------------------------------------
;
; Print a zero-terminated string on screen
; Input: DE = String address

;-----------------------------------------------------------------------------
;
; Wait until the bridge has a SD_DATA byte ready (read) or is ready to accept
; one (write), i.e. SD_STATUS bit5. Pure software polling of an immediate,
; non-WAIT_n-gated register - the bus is never stalled here, so Z80 refresh
; (and therefore MSX main DRAM) and interrupts keep running normally.
;
; Output: Cy=0 ready to transfer, Cy=1 gave up (error/timeout latched, or the
;         bounded wait expired). All other registers preserved.
;
; The bound below is ~1.4s worth of polling, comfortably past the SD spec's
; 1s worst case, because this is now cheap: it costs the CPU some cycles
; rather than freezing the whole machine.

; Set SD_ADDR0-3 to the 32-bit sector number at (ix) plus the 8-bit offset
; in E. Only A/F are modified. The carry from "add a,e" propagates through
; the following "adc a,0" instructions - ld a,(ix+n) does not touch flags.

SD_SET_ADDR:
	ld	a,(ix+0)
	add	a,e
	ld	(SD_ADDR0),a
	ld	a,(ix+1)
	adc	a,0
	ld	(SD_ADDR1),a
	ld	a,(ix+2)
	adc	a,0
	ld	(SD_ADDR2),a
	ld	a,(ix+3)
	adc	a,0
	ld	(SD_ADDR3),a
	ret


SD_WAIT_READY:
	push	bc
	push	de
	ld	d,8
SD_WAIT_READY_OUTER:
	ld	b,0
SD_WAIT_READY_LOOP:
	ld	a,(SD_STATUS)
	bit	SDSTAT_READY,a
	jr	nz,SD_WAIT_READY_OK
	and	M_SDSTAT_FAIL		;error or bridge timeout - stop waiting
	jr	nz,SD_WAIT_READY_FAIL
	ld	c,0
SD_WAIT_READY_INNER:
	dec	c
	jr	nz,SD_WAIT_READY_INNER
	djnz	SD_WAIT_READY_LOOP
	dec	d
	jr	nz,SD_WAIT_READY_OUTER

SD_WAIT_READY_FAIL:
	pop	de
	pop	bc
	scf				;Cy=1: not ready
	ret

SD_WAIT_READY_OK:
	pop	de
	pop	bc
	or	a			;Cy=0: ready
	ret


; Print A as two hex digits. CHPUT preserves the registers this relies on.
; Print one character, preserving EVERYTHING. Used to trace which driver
; entry points Nextor actually calls after DRV_INIT hands over.
;
; The byte-transfer counter on HEX has stayed at 00 across every run, which
; suggests Nextor may not be calling DEV_RW at all - i.e. it rejects the
; device from DEV_STATUS / LUN_INFO / DEV_INFO before ever reading a sector.
; This makes the actual call sequence visible instead of inferred.
DBGCHAR:
	push	af
	push	bc
	push	de
	push	hl
	push	ix
	push	iy
	call	CHPUT
	pop	iy
	pop	ix
	pop	hl
	pop	de
	pop	bc
	pop	af
	ret


PRINTHEX:
	push	af
	rrca
	rrca
	rrca
	rrca
	call	PRINTNIB
	pop	af
	call	PRINTNIB
	ret

PRINTNIB:
	and	0Fh
	add	a,'0'
	cp	'9'+1
	jr	c,PRINTNIB1
	add	a,7
PRINTNIB1:
	call	CHPUT
	ret


PRINT:
	ld	a,(de)
	or	a
	ret	z
	call	CHPUT
	inc	de
	jr	PRINT


;=======================
; Strings
;=======================

INFO_S:
	db	"SDMapper V2.1b XESS SD driver v"
	db	VER_MAIN+"0",".",VER_SEC+"0",".",VER_REV+"0",13,10
	db	"(c) Ronivon Costa 2026",13,10,0

OK_S:
	db	"SD card ready",13,10,0
NOCARD_S:
	db	"No SD card detected",13,10,0
TESTOK_S:
	db	"SD read OK (boot sig 55AA)",13,10,0
TESTBAD_S:
	db	"SD read BAD - wrong data from card",13,10,0
BYTEOK_S:
	db	"ADDR@512 OK -> card is BYTE-addressed (SDSC)",13,10,0
BYTEBAD_S:
	db	"ADDR@512 also bad -> not a byte-addressing issue",13,10,0
ADDRDUMP_S:
	db	"SD_ADDR readback: ",0
CRLF_S:
	db	13,10,0
INITDONE_S:
	db	"DRV_INIT complete - handing over to Nextor",13,10,0
MULTIOK_S:
	db	"SD sector 1 OK (FAT boot sector)",13,10,0
MULTIBAD_S:
	db	"SD sector 1 BAD - not a FAT boot sector",13,10,0

FAIL_S:
	db	"SD card initialization failed - check HEX/LEDG",13,10,0

DEVNAME_S:
	db	"SDMapper V2.1b XESS SD Card"
DEVNAME_LEN	equ	$-DEVNAME_S


;-----------------------------------------------------------------------------

DRV_END:

	end
