	; Device-based Nextor driver for SDMapper_V2.1b's XESS-core SD interface
	;
	; MSX_FPGA_Hat rev 2.1b (Terasic DE0). Talks to sdcard_bridge.vhd's
	; register window, which wraps a ported XESS Corp SdCardCtrl core
	; (github.com/xesscorp/VHDL_Lib/blob/master/SDCard.vhd) - all SD
	; protocol (CMD0/CMD8/ACMD41/CMD17/CMD24) runs in that hardware core;
	; this driver only ever does simple byte-level register I/O. Modeled
	; structurally on Nextor's own SunriseIDE driver.mac (jump table,
	; DRV_INIT flow, error-code conventions), but far simpler since there's
	; no low-level protocol bit-banging to do here.

	org 4100h

DRV_START:

	.print1 SDMapper V2.1b XESS SD driver

;-----------------------------------------------------------------------------
;
; Driver configuration constants

;Driver type: 0 for drive-based, 1 for device-based
DRV_TYPE	equ	1

;Hot-plug devices support: this board has no physical card-detect sensing,
;so no real hot-plug support.
DRV_HOTPLUG	equ	0

DEBUG	equ	0

;Driver version
VER_MAIN	equ	1
VER_SEC		equ	0
VER_REV		equ	0

;This driver has one important limitation, inherited from the underlying
;XESS core: only single-block-at-a-time addressing is exposed at the
;register level for the FIRST sector of a transfer, but the driver uses the
;core's own continue_i multi-block support for the rest, so multi-sector
;reads/writes ARE efficient (no re-issuing SD_ADDR0-3 per sector, matching
;how the sequential SD read/write commands work in hardware).


;-----------------------------------------------------------------------------
;
; SD card register window - see sdcard_bridge.vhd for the full protocol.
; Only visible when this cartridge's ROM bank 1 is switched to segment 7,
; which is exactly where mknexrom always places driver content (bank
; DRIVER_BANK = the kernel's own bank count, 7 for Nextor 2.1.x) - so these
; addresses are reachable any time this driver's own code is executing, no
; extra bank-switch needed.

SD_DATA		equ	7B00h	;R/W: next byte to/from an active block transfer (WAIT_n-gated)
SD_ADDR0	equ	7B01h	;W: block address bits 7:0
SD_ADDR1	equ	7B02h	;W: block address bits 15:8
SD_ADDR2	equ	7B03h	;W: block address bits 23:16
SD_ADDR3	equ	7B04h	;W: block address bits 31:24 (SDHC card - block number, not byte address)
SD_CMD		equ	7B05h	;W: bit7=reset pulse, bit1=write pulse, bit0=read pulse, bit2=continue
SD_STATUS	equ	7B06h	;R: b0=busy b1=error b2=present(SW0) b3=wprot(SW2) b4=timeout b5=byte-ready
SD_ERRLO	equ	7B07h	;R: SdCardCtrl's error_o(7:0), for diagnostics
SD_ERRHI	equ	7B08h	;R: SdCardCtrl's error_o(15:8), for diagnostics

SD_CMD_RESET	equ	80h
SD_CMD_READ		equ	01h
SD_CMD_WRITE	equ	02h
SD_CMD_CONTINUE	equ	04h

SDSTAT_BUSY		equ	0
SDSTAT_ERROR	equ	1
SDSTAT_PRESENT	equ	2
SDSTAT_WPROT	equ	3
SDSTAT_TIMEOUT	equ	4
;Bit 5 = sd_ready. WARNING: this is a per-BYTE transfer handshake
;(rx_ready_q or tx_ready_q in sdcard_bridge.vhd), NOT an init-status bit. It
;reads 0 whenever no transfer is in progress, so it must never be used to ask
;"is there a card" - doing so made every path report no card, always.
SDSTAT_READY	equ	5
;NOTE: sdcard_bridge.vhd has an init_done_q signal that IS a genuine "card
;initialised" flag, but it is wired only to LEDG(2) and is NOT in SD_STATUS.
;Exposing it needs an FPGA change - see BACKLOG.md. Until then SDSTAT_PRESENT
;(bit 2 = card_present_i = SW(0), a manual switch) is what we have.

M_SDSTAT_BUSY		equ	(1 SHL SDSTAT_BUSY)
M_SDSTAT_ERROR		equ	(1 SHL SDSTAT_ERROR)
M_SDSTAT_PRESENT	equ	(1 SHL SDSTAT_PRESENT)
M_SDSTAT_WPROT		equ	(1 SHL SDSTAT_WPROT)
M_SDSTAT_TIMEOUT	equ	(1 SHL SDSTAT_TIMEOUT)
M_SDSTAT_FAIL		equ	M_SDSTAT_ERROR+M_SDSTAT_TIMEOUT	;either bit means "something went wrong"


;-----------------------------------------------------------------------------
;
; Standard BIOS and work area entries

CHPUT	equ	00A2h	;Character output


;-----------------------------------------------------------------------------
;
; Error codes for DEV_RW and DEV_FORMAT (same codes MSX-DOS uses)

.NCOMP	equ	0FFh
.WRERR	equ	0FEh
.DISK	equ	0FDh
.NRDY	equ	0FCh
.DATA	equ	0FAh
.RNF	equ	0F9h
.WPROT	equ	0F8h
.UFORM	equ	0F7h
.SEEK	equ	0F3h
.IFORM	equ	0F0h
.IDEVL	equ	0B5h
.IPARM	equ	08Bh


;-----------------------------------------------------------------------------
;
; Routines available on kernel page 0

GSLOT1	equ	402Dh
RDBANK	equ	403Ch
CALBAS	equ	403Fh
CALBNK	equ	4042h
GWORK	equ	4045h
CALDRV	equ	4048h


;-----------------------------------------------------------------------------
;
; Driver signature

	db	"NEXTOR_DRIVER",0

;Driver flags: bit0=1 device-based, bit1=hotplug, bit2=1 (provides DRV_CONFIG)
	db	1+(2*DRV_HOTPLUG)+4

;Reserved byte
	db	0

;Driver name

DRV_NAME:
	db	"SDMapper V2.1b (XESS SD core)"
	ds	32-($-DRV_NAME)," "

;Jump table

	jp	DRV_TIMI
	jp	DRV_VERSION
	jp	DRV_INIT
	jp	DRV_BASSTAT
	jp	DRV_BASDEV
	jp	DRV_EXTBIO
	jp	DRV_DIRECT0
	jp	DRV_DIRECT1
	jp	DRV_DIRECT2
	jp	DRV_DIRECT3
	jp	DRV_DIRECT4
	jp	DRV_CONFIG

	ds	12

	jp	DEV_RW
	jp	DEV_INFO
	jp	DEV_STATUS
	jp	LUN_INFO
	jp	DEV_FORMAT
	jp	DEV_CMD


;-----------------------------------------------------------------------------
;
; Timer interrupt routine - not used by this driver.

DRV_TIMI:
	ret


;-----------------------------------------------------------------------------
;
; Driver initialization, called twice (see the Driver Development Guide for
; the full first/second-execution contract) - this driver needs no work
; area, so both executions just check/report the SD card's own state.
; SdCardCtrl's own CMD0/CMD8/ACMD41 sequence runs automatically from power-
; on/FPGA-configuration reset, independent of this routine - by the time
; DRV_INIT runs, initialization has typically already completed (or
; failed), so this mostly just reports what already happened, with a
; software reset pulse + a bounded wait as a safety net in case it hasn't.

TEMP_WORK	equ	0C000h

DRV_INIT:
	or	a
	ld	hl,0
	ld	a,2
	ret	z			;first execution: no work area needed, no timer hook

	ld	de,INFO_S
	call	PRINT

	;Pulse a software reset - cheap insurance so a soft MSX reset also
	;retries card detection, not just a full power cycle.
	ld	a,SD_CMD_RESET
	ld	(SD_CMD),a

	;Poll SD_STATUS for busy to clear. This is a genuine software polling
	;loop (SD_STATUS is an immediate/non-WAIT_n-gated read - see
	;sdcard_bridge.vhd) - same shape as the abandoned protocol's
	;WAIT_RESP-style loops, just watching a different bit. ~300ms bound
	;(256 outer * 256 inner iterations, a handful of T-states each).
	;Wait for sd_ready to ASSERT, not merely for busy to clear.
	;
	;BUG (2026-08-23): this waited on SDSTAT_BUSY clearing, with one 256x256
	;loop - about 220ms at 3.58MHz. The SD specification allows a card up to
	;ONE SECOND to complete ACMD41 from cold, so a cold boot fell through
	;before the card was ready and reported "SD Card not detected", while the
	;very next warm reboot found it already initialised and worked. Classic
	;works-on-the-second-try timing bug.
	;
	;Now polls READY with a ~1.8s budget (8 x ~220ms), which clears the
	;spec's 1s worst case with margin. Falling through on timeout is safe:
	;the caller treats "not ready" as no card, prints, and returns so the MSX
	;carries on booting.
	ld	d,8
DRV_INIT_WAIT_OUTER:
	ld	b,0
DRV_INIT_WAIT:
	ld	a,(SD_STATUS)
	bit	SDSTAT_BUSY,a
	jr	z,DRV_INIT_WAITDONE	;no longer busy - stop waiting
	ld	c,0
DRV_INIT_WAIT_INNER:
	dec	c
	jr	nz,DRV_INIT_WAIT_INNER
	djnz	DRV_INIT_WAIT
	dec	d
	jr	nz,DRV_INIT_WAIT_OUTER
DRV_INIT_WAITDONE:

	ld	a,(SD_STATUS)
	ld	c,a			;save status for the checks below

	;Decide on sd_ready, not on SDSTAT_PRESENT (hardwired '1' - see the
	;equates). No card, or a card that failed to initialise, both land here
	;and must return cleanly so Nextor hands control back and the MSX
	;carries on booting.
	bit	SDSTAT_PRESENT,c
	jr	z,DRV_INIT_NOCARD

	bit	SDSTAT_BUSY,c
	jr	nz,DRV_INIT_NOCARD	;still busy after the wait - no usable card

	ld	a,(SD_ERRLO)
	or	a
	jr	nz,DRV_INIT_NOCARD
	ld	a,(SD_ERRHI)
	or	a
	jr	nz,DRV_INIT_NOCARD

	ld	de,OK_S
	call	PRINT
	ret

DRV_INIT_NOCARD:
	ld	de,NOCARD_S
	call	PRINT
	ret


;-----------------------------------------------------------------------------
;
; Obtain driver version

DRV_VERSION:
	ld	a,VER_MAIN
	ld	b,VER_SEC
	ld	c,VER_REV
	ret


;-----------------------------------------------------------------------------
;
; BASIC expanded statement/device handlers - not implemented.

DRV_BASSTAT:
	scf
	ret

DRV_BASDEV:
	scf
	ret


;-----------------------------------------------------------------------------
;
; Extended BIOS hook - not used.

DRV_EXTBIO:
	ret


;-----------------------------------------------------------------------------
;
; Direct calls entry points - not used.

DRV_DIRECT0:
DRV_DIRECT1:
DRV_DIRECT2:
DRV_DIRECT3:
DRV_DIRECT4:
	ret


;-----------------------------------------------------------------------------
;
; Get driver configuration - this driver always uses the kernel's default
; (2 drives for a device-based driver), so it reports "not available" for
; every index, same simplification Nextor's own SunriseIDE driver uses.

DRV_CONFIG:
	ld	a,1
	ret


;=====
;=====  BEGIN of DEVICE-BASED specific routines
;=====

;-----------------------------------------------------------------------------
;
; Read or write logical sectors from/to a logical unit
;
;Input:    Cy=0 to read, 1 to write
;          A = Device number, 1 to 7 (always 1 - this board has one SD slot)
;          B = Number of sectors to read or write
;          C = Logical unit number, 1 to 7 (always 1)
;          HL = Source or destination memory address for the transfer
;          DE = Address where the 4 byte sector number is stored
;Output:   A = Error code (MSX-DOS codes, see equates above)
;          B = Number of sectors actually read or written

DEV_RW:
	push	af			;save Cy(r/w) + A(device index)

	ld	a,c			;LUN must be 1 (only one LUN on this device)
	cp	1
	jp	nz,DEV_RW_BADDEV

	;Pre-transfer state checks. Doing these BEFORE touching SD_DATA matters:
	;SD_DATA is WAIT_n-gated, so entering the transfer loop with a card that
	;cannot respond stalls the Z80 for ~10ms PER BYTE - about 5s per sector,
	;with Nextor retrying. That looks exactly like a hang.
	ld	a,(SD_STATUS)
	bit	SDSTAT_PRESENT,a
	jp	z,DEV_RW_NOTREADY
	ld	a,(SD_STATUS)
	bit	SDSTAT_BUSY,a
	jp	nz,DEV_RW_NOTREADY
	ld	a,(SD_ERRLO)
	or	a
	jp	nz,DEV_RW_ERRHARD
	ld	a,(SD_ERRHI)
	or	a
	jp	nz,DEV_RW_ERRHARD

	ld	a,b
	or	a
	jr	nz,DEV_RW_HASCOUNT
	pop	af
	xor	a
	ld	b,0
	ret				;0 sectors requested - trivially ok

DEV_RW_HASCOUNT:
	push	de
	pop	ix			;ix -> 4-byte sector number
	ld	e,0			;E = sector index within this transfer
	ld	c,b			;C = requested count, for the B fixup on exit
	pop	af			;Cy = r/w flag again
	jr	c,DEV_RW_DOWRITE

;--- READ ---
;
;ONE COMPLETE SINGLE-BLOCK COMMAND PER SECTOR: recompute the address as
;base+E, issue the command, WAIT for the core, then move 512 bytes.
;
;The previous version issued one command, then used SD_CMD_CONTINUE for the
;remaining sectors, and never waited at all - it read SD_DATA immediately
;after writing SD_CMD. Disassembling the known-good binary showed DEV_RW is
;228 bytes there against 175 here; this structure is the difference.

DEV_RW_RLOOP:
	call	SD_SETADDR
	ld	a,SD_CMD_READ
	ld	(SD_CMD),a
	call	SD_WAIT
	jp	c,DEV_RW_ERR

	push	bc
	ld	bc,512
DEV_RW_RBYTE:
	ld	a,(SD_DATA)
	ld	(hl),a
	inc	hl
	dec	bc
	ld	a,b
	or	c
	jr	nz,DEV_RW_RBYTE
	pop	bc

	ld	a,(SD_STATUS)
	and	M_SDSTAT_FAIL
	jp	nz,DEV_RW_ERR

	inc	e			;next sector
	djnz	DEV_RW_RLOOP

	ld	b,c			;B = sectors transferred, which Nextor expects.
					;Falling out of djnz leaves B=0 - the old code
					;returned that, reporting nothing transferred.
	xor	a
	ret

;--- WRITE ---

DEV_RW_DOWRITE:
	ld	a,(SD_STATUS)
	bit	SDSTAT_WPROT,a
	jp	nz,DEV_RW_WPROTERR

DEV_RW_WLOOP:
	call	SD_SETADDR
	ld	a,SD_CMD_WRITE
	ld	(SD_CMD),a
	call	SD_WAIT
	jp	c,DEV_RW_ERR

	push	bc
	ld	bc,512
DEV_RW_WBYTE:
	ld	a,(hl)
	ld	(SD_DATA),a
	inc	hl
	dec	bc
	ld	a,b
	or	c
	jr	nz,DEV_RW_WBYTE
	pop	bc

	ld	a,(SD_STATUS)
	and	M_SDSTAT_FAIL
	jp	nz,DEV_RW_ERR

	inc	e
	djnz	DEV_RW_WLOOP

	ld	b,c
	xor	a
	ret

;-----------------------------------------------------------------------------
;
; Set SD_ADDR0-3 to the 32-bit sector number at (IX) plus E.
;
; The working driver recomputes the full address for EVERY sector instead of
; using the core's continue mode, so each sector is an independent single-block
; command. Only A and the flags are modified - E, BC, HL and IX survive.

SD_SETADDR:
	ld	a,(ix+0)
	add	a,e
	ld	(SD_ADDR0),a
	ld	a,(ix+1)
	adc	a,0
	ld	(SD_ADDR1),a
	ld	a,(ix+2)
	adc	a,0
	ld	(SD_ADDR2),a
	ld	a,(ix+3)
	adc	a,0
	ld	(SD_ADDR3),a
	ret

;-----------------------------------------------------------------------------
;
; Wait for the core to be ready to move the first byte of a block.
;
; MUST be called after every SD_CMD write. SD_STATUS bit 5 is the per-BYTE
; transfer handshake - "a prefetched byte is available, or the core can accept
; a write byte" - so it is exactly right here, and exactly WRONG as an answer
; to "is a card present", which is how a whole session was lost.
;
; Exit: Cy=0 ready, Cy=1 on error or timeout. Budget is 8 x 256 polls with a
; 256-iteration delay between them, matching the known-good binary.

SD_WAIT:
	push	bc
	push	de
	ld	d,8
SD_WAIT_OUTER:
	ld	b,0
SD_WAIT_POLL:
	ld	a,(SD_STATUS)
	bit	SDSTAT_READY,a
	jr	nz,SD_WAIT_OK
	and	M_SDSTAT_FAIL
	jr	nz,SD_WAIT_FAIL
	ld	c,0
SD_WAIT_DLY:
	dec	c
	jr	nz,SD_WAIT_DLY
	djnz	SD_WAIT_POLL
	dec	d
	jr	nz,SD_WAIT_OUTER
SD_WAIT_FAIL:
	pop	de
	pop	bc
	scf
	ret
SD_WAIT_OK:
	pop	de
	pop	bc
	or	a
	ret

;--- Error handling ---

DEV_RW_ERR:
	push	af
	ld	a,SD_CMD_RESET		;recover SdCardCtrl - it stalls on error until reset (its own documented behaviour)
	ld	(SD_CMD),a
	pop	af

	bit	SDSTAT_TIMEOUT,a
	jr	nz,DEV_RW_ERR_NRDY
	ld	a,.DISK
	ld	b,0
	ret
DEV_RW_ERR_NRDY:
	ld	a,.NRDY
	ld	b,0
	ret

	;Reached with the entry "push af" still on the stack - balance it.
DEV_RW_ERRHARD:
	pop	af
	ld	a,.DISK
	ld	b,0
	ret

DEV_RW_WPROTERR:
	ld	a,.WPROT
	ld	b,0
	ret

DEV_RW_BADDEV:
	pop	af
	ld	a,.IDEVL
	ld	b,0
	ret

	;Reached with the entry "push af" still on the stack - balance it.
DEV_RW_NOTREADY:
	pop	af
	ld	a,.NRDY
	ld	b,0
	ret


;-----------------------------------------------------------------------------
;
; Device information gathering
;
;Input:   A = Device index, 1 to 7
;         B = Information to return: 0=basic, 1=manufacturer, 2=device name, 3=serial
;         HL = Pointer to a buffer in RAM
;Output:  A = 0 Ok, 1 device/index invalid, 2 information not available
;         Buffer filled per the Driver Development Guide's DEV_INFO contract.

DEV_INFO:
	or	a
	jr	z,DEV_INFO_ERR1
	cp	2
	jr	nc,DEV_INFO_ERR1

	ld	a,b
	or	a
	jr	nz,DEV_INFO_STRING

	ld	(hl),1			;one LUN
	inc	hl
	ld	(hl),0			;flags always zero
	xor	a
	ret

DEV_INFO_STRING:
	push	bc
	push	hl
	push	hl
	pop	de
	inc	de
	ld	(hl)," "
	ld	bc,64-1
	ldir
	pop	hl
	pop	bc

	ld	a,b
	cp	1
	jr	z,DEV_INFO_MANUF
	cp	2
	jr	z,DEV_INFO_DEVNAME
	jr	DEV_INFO_ERR2		;3 = serial number, not available

DEV_INFO_MANUF:
	ld	de,MANUF_S
	ld	bc,MANUF_LEN
	jr	DEV_INFO_COPY

DEV_INFO_DEVNAME:
	ld	de,DEVNAME_S
	ld	bc,DEVNAME_LEN

	;BUG FIX: ldir copies (HL)->(DE), and on entry HL is the DESTINATION
	;buffer while DE has just been loaded with the SOURCE string - the wrong
	;way round. It copied the blank buffer onto the ROM string (a no-op) and
	;left the caller's buffer full of spaces, so FDISK printed the device
	;number followed by 64 blanks: "1." and nothing else. Swap them first.
DEV_INFO_COPY:
	ex	de,hl			;HL = source string, DE = destination buffer
	ldir
	xor	a
	ret

DEV_INFO_ERR1:
	ld	a,1
	ret
DEV_INFO_ERR2:
	ld	a,2
	ret


;-----------------------------------------------------------------------------
;
; Obtain device status
;
;Input:   A = Device index, 1 to 7
;         B = Logical unit number, 1 to 7 (0 = the device itself)
;Output:  A = 0 not available/invalid, 1 available unchanged,
;             2 available changed, 3 available unknown-change
;
; This board has no physical card-detect sensing, so no real hot-plug/change
; tracking - always "unchanged" while the card reports ready.

DEV_STATUS:
	or	a
	jr	z,DEV_STATUS_NA
	cp	2
	jr	nc,DEV_STATUS_NA
	ld	a,b
	cp	2
	jr	nc,DEV_STATUS_NA

	;Report the device available ONLY if the card actually initialised.
	;
	;This used to test SDSTAT_PRESENT, which is hardwired '1', so the device
	;was always reported available. With no card inserted Nextor believed it,
	;issued a read, and the machine HUNG at boot. Testing sd_ready instead
	;makes Nextor skip the device and carry on booting.
	ld	a,(SD_STATUS)
	bit	SDSTAT_PRESENT,a
	jr	z,DEV_STATUS_NA
	ld	a,(SD_STATUS)
	bit	SDSTAT_ERROR,a
	jr	nz,DEV_STATUS_NA

	ld	a,1
	ret
DEV_STATUS_NA:
	xor	a
	ret


;-----------------------------------------------------------------------------
;
; Obtain logical unit information
;
;Input:   A = Device index, 1 to 7
;         B = Logical unit number, 1 to 7
;         HL = Pointer to buffer in RAM
;Output:  A = 0 Ok / 1 error
;
; Capacity is unknown (this driver doesn't parse the SD card's CSD
; register) - reported as 0, the documented "not available" value.

LUN_INFO:
	or	a
	jr	z,LUN_INFO_ERR
	cp	2
	jr	nc,LUN_INFO_ERR
	ld	a,b
	cp	1
	jr	nz,LUN_INFO_ERR

	;No usable card means no logical unit. Without this we advertised a
	;perfectly healthy 16GB block device with nothing in the slot, which is
	;how a missing card ended up being read from at all.
	ld	a,(SD_STATUS)
	bit	SDSTAT_PRESENT,a
	jr	z,LUN_INFO_ERR

	push	hl
	pop	ix
	ld	(ix+0),0		;block device
	ld	(ix+1),0		;sector size = 512
	ld	(ix+2),2
	;Total sectors, 32-bit little-endian across (ix+3)..(ix+6).
	;
	;This MUST be non-zero. FDISK refuses to partition a logical unit whose
	;size it does not know and reports "there are no suitable logical units
	;available in the device" - the card still enumerates, so it looks
	;detected but cannot be partitioned or booted from.
	;
	;0x02000000 = 33,554,432 sectors x 512 = 16GB. It is HARDCODED: the FPGA
	;bridge exposes SD_DATA/SD_STATUS/SD_ERRLO/SD_ERRHI only, with no capacity
	;register, and the XESS core runs the SD protocol internally so CMD9
	;(SEND_CSD) is not reachable from here. This is why FDISK always shows a
	;16GB card whatever is actually inserted.
	ld	(ix+3),0
	ld	(ix+4),0
	ld	(ix+5),0
	ld	(ix+6),2
	;Feature flags: bit0 removable, bit1 read only, bit2 floppy,
	;bit3 no automapping.
	;
	;DEFERRED 2026-08-23: driving bit 1 from SD_STATUS bit 3 (SW(2) on this
	;core) is correct and is in BACKLOG.md, but it adds a switch dependency -
	;with SW(2) ON, FDISK refuses to partition, which is easy to misread as a
	;DEV_RW failure. Left at 0 so this build tests ONE thing: the DEV_RW
	;rewrite.
	ld	(ix+7),0
	ld	(ix+8),0		;cylinders = 0 (not applicable)
	ld	(ix+9),0
	ld	(ix+10),0		;heads = 0
	ld	(ix+11),0		;sectors/track = 0
	xor	a
	ret

LUN_INFO_ERR:
	ld	a,1
	ret


;-----------------------------------------------------------------------------
;
; Physical format - not supported.

DEV_FORMAT:
	ld	a,.IFORM
	ret


;-----------------------------------------------------------------------------
;
; Direct device command - not supported.

DEV_CMD:
	ld	a,2
	ret

;=====
;=====  END of DEVICE-BASED specific routines
;=====


;=======================
; Subroutines
;=======================

;-----------------------------------------------------------------------------
;
; Print a zero-terminated string on screen
; Input: DE = String address

PRINT:
	ld	a,(de)
	or	a
	ret	z
	call	CHPUT
	inc	de
	jr	PRINT


;=======================
; Strings
;=======================

INFO_S:
	db	"SDMapper V2.1b XESS SD driver v"
	db	VER_MAIN+"0",".",VER_SEC+"0",".",VER_REV+"0",13,10
	db	"(c) Ronivon Costa 2026",13,10,0

OK_S:
	db	"SD card ready",13,10,0
NOCARD_S:
	db	"SD Card not detected",13,10,0

;DEV_INFO strings. Nextor gives a 64-byte buffer, blank-padded by the caller
;above, so these need no terminator and must not exceed 64 characters.
DEVNAME_S:
	db	"SDMapper V2.1b XESS SD Card"
DEVNAME_LEN	equ	$-DEVNAME_S

MANUF_S:
	db	"Ronivon Costa"
MANUF_LEN	equ	$-MANUF_S


;-----------------------------------------------------------------------------

DRV_END:

	end
